<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.mentafinance</groupId>
    <artifactId>menta-finance-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>menta-finance-backend</name>
    <description>Backend ya Menta Finance - Spring Boot + PostgreSQL</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
            <!-- ============================================================
             11. PDF GENERATION: OpenPDF - fork huru ya iText4, leseni
                 LGPL/MPL (bure kwa matumizi ya kibiashara, tofauti na
                 iText7 mpya yenye leseni ya AGPL yenye masharti).
             ============================================================ -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.30</version>
        </dependency>

        <!-- ============================================================
             1. WEB: Inatuwezesha kuandika REST Controllers (@RestController,
                @GetMapping, n.k.) na kuendesha embedded Tomcat server.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ============================================================
             2. DATA JPA: Inatuwezesha kuandika Entities (@Entity) na
                Repositories (JpaRepository) badala ya kuandika SQL
                queries za CRUD zote wenyewe.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ============================================================
             3. VALIDATION: Inatuwezesha kutumia @NotNull, @NotBlank,
                @Positive n.k. kwenye DTO za request ili kuzuia data
                mbaya kabla haijafika kwenye database (mf. amount hasi).
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ============================================================
             4. SECURITY: Msingi wa kuzuia/kuruhusu watumiaji kufikia
                endpoints kulingana na role (SUPERADMIN/MANAGER/STAFF).
                Tutaongeza JWT juu ya hii.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ============================================================
             5. JWT (JSON Web Token): Maktaba ya kutengeneza na
                kusoma tokens za login (badala ya session-based auth,
                ambayo si rahisi kwa API zinazoweza kutumiwa na app
                nyingi - web, mobile n.k.)
             ============================================================ -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.11.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================================================
             6. POSTGRESQL DRIVER: "Mtafsiri" kati ya Java na PostgreSQL
                database - bila hii, Java haiwezi kuongea na Postgres.
             ============================================================ -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================================================
             7. FLYWAY: Usimamizi wa database migrations (badala ya
                Hibernate ddl-auto). Tunaandika SQL scripts halisi
                zenye version, na Flyway anazitekeleza kwa mpangilio.
             ============================================================ -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ============================================================
             8. LOMBOK: Inapunguza "boilerplate code" (getters/setters/
                constructors) kwa kutumia annotations tu (@Data,
                @Getter, @Builder). Hii inafanya Entity/DTO classes
                kuwa fupi na rahisi kusoma.
             ============================================================ -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ============================================================
             9. SWAGGER/OPENAPI: Inatengeneza UI ya kujaribu API zetu
                moja kwa moja kwenye browser (http://localhost:8080/
                swagger-ui.html) - muhimu sana kwa testing bila Postman.
             ============================================================ -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <!-- ============================================================
             10. TEST: Zana za kuandika unit/integration tests.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
